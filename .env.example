# MongoDB connection string.
# Production: the managed cluster URI.
# Local / demo: point at the isolated Docker mongo (npm run db:up):
#   mongodb://localhost:27017/?directConnection=true
# The app always uses the "bounties" database on whatever host this URI targets,
# so isolation from prod comes from using a DIFFERENT host here.
MONGODB_URI=

# IMPORTANT: the demo instance MUST use a JWT_SECRET distinct from production.
# /api/demo/login mints tokens signed with this secret, and the auth guards trust
# the JWT alone (they do not re-check the DB). A shared secret would make demo
# tokens valid on the real production app.
JWT_SECRET=
JWT_EXPIRES_IN=

PRIVY_APP_ID=
PRIVY_SECRET=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

NODE_ENV=
FRONT_URL=
PORT=

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://bounties.work,http://localhost:3000

# JWT - token expiration (default: 7d for access, 30d for refresh)
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cron jobs - secret to authenticate Vercel cron requests (required)
CRON_SECRET=

# ─── Demo / 37 Graus sprint rehearsal ──────────────────────────────────────────
# These power a throwaway demo environment. Keep them UNSET on the real prod app.
# Deploy model: same code, separate env/instance + isolated DB + distinct JWT_SECRET.
#
# Mounts POST /api/demo/login (mints HOST/CREATOR demo tokens; never ADMIN/arbiter).
# Only "true" enables it. Leave blank/absent in production.
DEMO_LOGIN_ENABLED=
# TTL of demo-issued JWTs (default 12h). Short on purpose to limit leak blast radius.
DEMO_TOKEN_TTL=12h
# Enables POST /api/seed/demo-campaign (seeds demo host/talents/campaigns).
# Set to a strong random value ONLY on the demo instance; send as x-seed-secret header.
SEED_SECRET=

# Redis cache (optional - falls back to in-memory if not set)
# Get free at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RPC URLs per chain (required for payments)
RPC_BASE_URL=
RPC_ARBITRUM_URL=
RPC_ETHEREUM_URL=
RPC_BERACHAIN_URL=
RPC_BSC_URL=
RPC_POLYGON_URL=
RPC_HYPEREVM_URL=
RPC_SOLANA_URL=
RPC_SUI_URL=

# Optional: some RPC providers (ex.: Ankr with origin allowlist) may require headers
RPC_ORIGIN=
RPC_REFERER=

# Destination wallets for payment collection (required)
WALLET_DESTINATION_EVM=
WALLET_DESTINATION_SOLANA=
WALLET_DESTINATION_SUI=
WALLET_DESTINATION_STELLAR=

# Stellar Escrow — Trustless escrow system on Stellar L1
# "mainnet" → public network (real funds; treasury MUST be funded with XLM)
# "testnet" → test network (friendbot-funded)
STELLAR_NETWORK=testnet
# Treasury: source account that pays fees + sponsors escrow reserves. Must hold real XLM on mainnet.
STELLAR_TREASURY_PUBLIC_KEY=
STELLAR_TREASURY_SECRET_KEY=
# Arbiter: signer-only key (does NOT need on-chain funding — used purely to sign).
STELLAR_ARBITER_PUBLIC_KEY=
STELLAR_ARBITER_SECRET_KEY=
# 32-byte hex key for AES-256-GCM encryption of escrow secret keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STELLAR_ESCROW_ENCRYPTION_KEY=
# USDC issuer. Mainnet (Circle): GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Defaults per-network in config if unset.
STELLAR_USDC_ISSUER=

# ─── CCTP V2 (Circle Cross-Chain Transfer Protocol) — inbound funding ──────────
# Lets a host fund the escrow by burning native USDC on any CCTP source chain
# (Ethereum/Arbitrum/Base/Polygon/Solana/Sui). Berachain/BSC/HyperEVM are NOT
# CCTP-supported by Circle — those keep using the regular payment path.
# Circle mints onto the escrow's Stellar account via the CctpForwarder (domain 27).
# Feature flag — keep false until tested end-to-end on testnet.
CCTP_ENABLED=false
# Soroban RPC (Stellar smart-contract layer). Defaults per-network in config.
# testnet: https://soroban-testnet.stellar.org | mainnet: https://mainnet.sorobanrpc.com
STELLAR_SOROBAN_RPC_URL=
# Circle Iris attestation API. Defaults per-network (sandbox for testnet).
CCTP_IRIS_BASE_URL=
# Optional Bearer token for the Iris API (if your account requires one).
CCTP_IRIS_API_KEY=
