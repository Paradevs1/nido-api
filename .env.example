MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=

PRIVY_APP_ID=
PRIVY_SECRET=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

NODE_ENV=
FRONT_URL=
PORT=

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://bounties.work,http://localhost:3000

# JWT - token expiration (default: 7d for access, 30d for refresh)
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cron jobs - secret to authenticate Vercel cron requests (required)
CRON_SECRET=

# Redis cache (optional - falls back to in-memory if not set)
# Get free at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RPC URLs per chain (required for payments)
RPC_BASE_URL=
RPC_ARBITRUM_URL=
RPC_ETHEREUM_URL=
RPC_BERACHAIN_URL=
RPC_BSC_URL=
RPC_POLYGON_URL=
RPC_HYPEREVM_URL=
RPC_SOLANA_URL=
RPC_SUI_URL=

# Optional: some RPC providers (ex.: Ankr with origin allowlist) may require headers
RPC_ORIGIN=
RPC_REFERER=

# Destination wallets for payment collection (required)
WALLET_DESTINATION_EVM=
WALLET_DESTINATION_SOLANA=
WALLET_DESTINATION_SUI=
